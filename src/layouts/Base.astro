---
import { site } from '../data/works';
const { title = site.name } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  ['Works', '/'],
  ['Profile', '/profile/'],
  ['Requests', '/requests/'],
  ['Thoughts', '/thoughts/'],
  ['Music', '/music/'],
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@300;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <a href={`${base}/`}>{site.name}</a>
      <nav>
        {nav.map(([label, path]) => <a href={`${base}${path}`}>{label}</a>)}
      </nav>
    </header>
    <slot />
    <footer>
      <span>{site.about}</span>
      <a href={`mailto:${site.contact}`}>{site.contact}</a>
    </footer>
  </body>
</html>

<style is:global>
  :root { --paper: #eceeef; --ink: #1a1a1a; --mute: #80848a; --line: color-mix(in srgb, var(--ink) 18%, transparent); }
  @media (prefers-color-scheme: dark) { :root { --paper: #16171a; --ink: #e6e7e9; --mute: #7d8087; } }
  * { box-sizing: border-box; margin: 0; }
  html { background: var(--paper); color: var(--ink); }
  body { font-family: 'Zen Kaku Gothic New', sans-serif; font-weight: 300; line-height: 1.7; min-height: 100vh; display: flex; flex-direction: column; }
  a { color: inherit; text-decoration: none; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  header, footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1.5rem; padding: 1.25rem clamp(1rem, 4vw, 3rem); font-size: .875rem; }
  header nav { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; }
  header nav a:hover { text-decoration: underline; text-underline-offset: 4px; }
  footer { margin-top: auto; color: var(--mute); }
  footer a:hover { color: var(--ink); }
  .ph { width: 100%; background: linear-gradient(160deg, var(--a), var(--b)); }
  img.ph { object-fit: cover; display: block; }

  /* 文章ページ共通 */
  .page { padding: 2rem clamp(1rem, 4vw, 3rem) 4rem; max-width: 760px; width: 100%; margin: 0 auto; }
  .page h1.title { font-size: clamp(2rem, 6vw, 3.5rem); font-weight: 300; line-height: 1.2; margin-bottom: 2rem; }
  .prose h1 { font-size: clamp(2rem, 6vw, 3.5rem); font-weight: 300; line-height: 1.2; margin: 3rem 0 1.5rem; }
  .prose > h1:first-child { margin-top: 0; }
  .prose h2 { font-size: 1.25rem; font-weight: 500; margin: 2.5rem 0 .75rem; }
  .prose h3 { font-size: 1.05rem; font-weight: 500; margin: 2rem 0 .25rem; }
  .prose p, .prose ul { margin-bottom: 1rem; max-width: 40em; }
  .prose ul { padding-left: 1.25rem; }
  .prose li { margin-bottom: .25rem; }
  .prose strong { font-weight: 500; }
  .prose hr { border: 0; border-top: 1px solid var(--line); margin: 2.5rem 0; }
</style>
