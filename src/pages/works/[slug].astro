---
import Base from '../../layouts/Base.astro';
import { works } from '../../data/works';
export function getStaticPaths() {
  return works.map((w, i) => ({
    params: { slug: w.slug },
    props: { w, prev: works[(i - 1 + works.length) % works.length], next: works[(i + 1) % works.length] },
  }));
}
const { w, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${w.title} | 写真`}>
  <main>
    {w.file
      ? <img class="ph develop" src={`${base}/photos/${w.file}`} alt={w.title} />
      : <div class="ph develop" style={`aspect-ratio:${w.ratio};--a:${w.tones[0]};--b:${w.tones[1]}`}></div>}
    <div class="cap">
      <h1>{w.title}</h1>
      <p>{w.place}　{w.year}</p>
    </div>
    <nav>
      <a href={`${base}/works/${prev.slug}/`}>{prev.title}</a>
      <a href={`${base}/`}>一覧</a>
      <a href={`${base}/works/${next.slug}/`}>{next.title}</a>
    </nav>
  </main>
</Base>

<style>
  main { padding: 0 clamp(1rem, 4vw, 3rem) 3rem; max-width: 1200px; margin: 0 auto; width: 100%; }
  .ph { max-height: 80vh; object-fit: contain; }
  .develop { animation: develop 1.8s ease-out both; }
  @keyframes develop { from { filter: brightness(0) blur(14px); } to { filter: none; } }
  @media (prefers-reduced-motion: reduce) { .develop { animation: none; } }
  .cap { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 1rem 0 2.5rem; }
  h1 { font-size: 1.25rem; font-weight: 500; }
  .cap p { color: var(--mute); font-size: .875rem; }
  nav { display: flex; justify-content: space-between; gap: 1rem; font-size: .875rem; border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); padding-top: 1rem; }
  nav a:hover { text-decoration: underline; text-underline-offset: 4px; }
</style>
